{
  "name": "@crashbytes/project-tracker-mcp",
  "version": "1.0.0",
  "description": "An MCP server for project task tracking. Companion repo for the CrashBytes tutorial on building MCP servers in TypeScript.",
  "type": "module",
  "bin": {
    "project-tracker-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "typescript",
    "project-tracker"
  ],
  "author": "Michael Eakins",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0",
    "path-to-regexp": "^8.4.0",
    "express-rate-limit": "^8.2.2",
    "@hono/node-server": "^2.0.5",
    "hono": "^4.12.27",
    "qs": "^6.15.2",
    "body-parser": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
